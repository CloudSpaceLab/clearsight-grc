FROM golang:1.26.5-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY api ./api
COPY migrations ./migrations
COPY docs ./docs

RUN CGO_ENABLED=0 go test -tags postgres ./... && \
    CGO_ENABLED=0 go build -tags postgres -trimpath -ldflags="-s -w" -o /out/clearsight-worker ./cmd/worker && \
    mkdir -p /out/artifacts && \
    chown -R 65532:65532 /out/artifacts

FROM debian:12.12-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates poppler-utils && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /out/clearsight-worker /clearsight-worker
COPY --from=build --chown=65532:65532 /out/artifacts /var/lib/clearsight/artifacts

USER 65532:65532

ENTRYPOINT ["/clearsight-worker"]
