FROM golang:1.26.5-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go test ./... && \
    CGO_ENABLED=0 go test -tags postgres ./... && \
    CGO_ENABLED=0 go build -tags postgres -trimpath -ldflags="-s -w" -o /out/clearsight-api ./cmd/api && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/clearsight-healthcheck ./cmd/healthcheck
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/clearsight-api /clearsight-api
COPY --from=build /out/clearsight-healthcheck /clearsight-healthcheck
EXPOSE 8080
USER nonroot:nonroot
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD ["/clearsight-healthcheck", "http://127.0.0.1:13281/health/ready"]
ENTRYPOINT ["/clearsight-api"]
