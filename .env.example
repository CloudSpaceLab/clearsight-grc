CLEARSIGHT_ENV=development
CLEARSIGHT_HTTP_ADDR=:8080
CLEARSIGHT_ALLOWED_ORIGIN=http://localhost:5173
CLEARSIGHT_LOG_LEVEL=info
CLEARSIGHT_READ_TIMEOUT=5s
CLEARSIGHT_WRITE_TIMEOUT=10s
CLEARSIGHT_IDLE_TIMEOUT=60s
CLEARSIGHT_QUERY_TIMEOUT=3s
CLEARSIGHT_DB_MIN_CONNS=2
CLEARSIGHT_DB_MAX_CONNS=20
CLEARSIGHT_WORKER_ID=worker-local
CLEARSIGHT_WORKER_POLL=1s
CLEARSIGHT_ARTIFACT_ROOT=./var/artifacts
CLEARSIGHT_MAX_ARTIFACT_BYTES=20971520
CLEARSIGHT_CAPTURE_SESSION_TTL=20m
# Enables stakeholder reference journeys and development fixtures. Production rejects true.
CLEARSIGHT_DEMO_MODE=true
# Development may analyze locally stored unscanned documents. Production defaults false.
CLEARSIGHT_DOCUMENT_IMPORT_ALLOW_UNSCANNED_ANALYSIS=true
# development uses the configured demo identity; signed keeps the trusted gateway contract; oidc enables native enterprise sign-in.
CLEARSIGHT_IDENTITY_MODE=development
CLEARSIGHT_IDENTITY_HMAC_SECRET=
CLEARSIGHT_IDENTITY_MAX_SKEW=2m
# OIDC mode uses Authorization Code + PKCE and server-side SCS sessions.
# CLEARSIGHT_ALLOWED_ORIGIN is also the trusted application origin used after the callback.
CLEARSIGHT_OIDC_ISSUER=
CLEARSIGHT_OIDC_CLIENT_ID=
CLEARSIGHT_OIDC_CLIENT_SECRET=
CLEARSIGHT_OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
CLEARSIGHT_OIDC_SESSION_LIFETIME=8h
CLEARSIGHT_OIDC_SESSION_IDLE_TIMEOUT=30m
# Production OIDC requires true and HTTPS issuer/application/callback URLs.
CLEARSIGHT_OIDC_SECURE_COOKIES=false
# off, audit or enforce. Production requires enforce.
CLEARSIGHT_COMMAND_AUTHORIZATION=audit
CLEARSIGHT_DEMO_TENANT_ID=bank-demo
CLEARSIGHT_DEMO_PRINCIPAL_ID=role-cro
CLEARSIGHT_DEMO_LEGAL_ENTITY_ID=bank-ng
# Comma-separated role codes select the first-run guide. Examples: CRO, PROGRAM_OWNER, REVIEWER, AUTHORIZER, EVIDENCE_RESPONDENT, GRC_ADMIN, AUDITOR.
CLEARSIGHT_DEMO_ROLE_CODES=CRO,EXECUTIVE
DATABASE_URL=postgres://clearsight:clearsight@localhost:5432/clearsight?sslmode=disable
VITE_API_BASE_URL=http://localhost:8080
# Optional browser-only fallback when the API is unavailable; server demo mode remains authoritative.
VITE_ENABLE_SAMPLE_DATA=false
