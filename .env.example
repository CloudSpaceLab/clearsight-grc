CLEARSIGHT_ENV=development
CLEARSIGHT_HTTP_ADDR=:8080
CLEARSIGHT_ALLOWED_ORIGIN=http://localhost:5173
CLEARSIGHT_LOG_LEVEL=info
CLEARSIGHT_READ_TIMEOUT=5s
CLEARSIGHT_WRITE_TIMEOUT=10s
CLEARSIGHT_IDLE_TIMEOUT=60s
CLEARSIGHT_QUERY_TIMEOUT=3s
CLEARSIGHT_DB_MIN_CONNS=2
CLEARSIGHT_DB_MAX_CONNS=20
CLEARSIGHT_WORKER_ID=worker-local
CLEARSIGHT_WORKER_POLL=1s
# Bounded deterministic vendor refresh detection. This creates owner work only;
# external forms are sent only through an approved distribution workflow.
CLEARSIGHT_VENDOR_REFRESH_BATCH_SIZE=100
CLEARSIGHT_VENDOR_REFRESH_CADENCE=15m
CLEARSIGHT_VENDOR_REFRESH_LEASE=1m
CLEARSIGHT_VENDOR_REFRESH_DOCUMENT_LEAD=30d
CLEARSIGHT_VENDOR_REFRESH_FACT_CONFIRMATION_INTERVAL=365d
CLEARSIGHT_ARTIFACT_ROOT=./var/artifacts
CLEARSIGHT_MAX_ARTIFACT_BYTES=20971520
CLEARSIGHT_CAPTURE_SESSION_TTL=20m
# Optional public vendor-response page. Use HTTPS outside local development.
CLEARSIGHT_CAPTURE_PUBLIC_BASE_URL=
# External distribution delivery remains disabled until encryption and access keys are configured.
CLEARSIGHT_EXTERNAL_DISTRIBUTION_DELIVERY_ENABLED=false
# JSON object mapping key IDs to base64-encoded 32-byte AES keys.
CLEARSIGHT_RECIPIENT_KEYRING=
CLEARSIGHT_RECIPIENT_ACTIVE_KEY_ID=
# Separate base64-encoded 32-byte HMAC key for route-bound recipient selectors and OTP challenges.
CLEARSIGHT_DISTRIBUTION_ACCESS_HMAC_KEY=
# Set true only after the recipient keys, HTTPS capture URL and SMTP settings below pass the hosted readiness check.
# Governed form email delivery. STARTTLS or TLS is required outside development.
# The SMTP credential is resolved only through the referenced environment variable.
CLEARSIGHT_SMTP_HOST=
CLEARSIGHT_SMTP_PORT=587
CLEARSIGHT_SMTP_USERNAME=
CLEARSIGHT_SMTP_SECRET_REF=env:CLEARSIGHT_SMTP_PASSWORD
CLEARSIGHT_SMTP_PASSWORD=
CLEARSIGHT_SMTP_FROM=
CLEARSIGHT_SMTP_TLS_MODE=STARTTLS
VERIFY_EMAIL_READINESS=false
# Enables stakeholder reference journeys and the role-aware demo login. Production rejects true.
# Built-in demo accounts are shown on the demo login page and all use password: demo.
CLEARSIGHT_DEMO_MODE=true
# Optional seeded Program Owner mailbox used to exercise staff-assignment email in non-production.
# Keep empty unless the mailbox is controlled for the reference journey.
CLEARSIGHT_DEMO_STAFF_EMAIL=
# Development may analyze locally stored unscanned documents. Production defaults false.
CLEARSIGHT_DOCUMENT_IMPORT_ALLOW_UNSCANNED_ANALYSIS=true
# Optional Task 16 parser adapters. Empty keeps the built-in parser path and all adapters disabled.
# PYMUPDF requires an internal endpoint plus explicit license approval; HTTPS is required outside development.
CLEARSIGHT_PDF_PARSER_ADAPTER=
CLEARSIGHT_PDF_PARSER_ENDPOINT=
CLEARSIGHT_PYMUPDF_LICENSE_APPROVED=false
CLEARSIGHT_PARSER_ADAPTER_TIMEOUT=30s
CLEARSIGHT_PARSER_ADAPTER_MAX_OUTPUT_BYTES=8388608
# Legacy .xls conversion remains disabled unless an isolated converter executable is explicitly configured.
CLEARSIGHT_LEGACY_OFFICE_EXECUTABLE=
CLEARSIGHT_LEGACY_OFFICE_TIMEOUT=30s
CLEARSIGHT_LEGACY_OFFICE_MAX_OUTPUT_BYTES=67108864
# Governed form-authoring AI remains disabled unless all gateway binding values are configured together.
# Treat CLEARSIGHT_FORM_AI_CREDENTIAL as a secret; the gateway URL must use HTTPS outside development.
CLEARSIGHT_FORM_AI_GATEWAY_URL=
CLEARSIGHT_FORM_AI_TENANT_ID=
CLEARSIGHT_FORM_AI_WORKLOAD_ID=
CLEARSIGHT_FORM_AI_CREDENTIAL=
CLEARSIGHT_FORM_AI_MODEL_ALIAS=
CLEARSIGHT_FORM_AI_PROMPT_VERSION=FORM_AUTHORING_V1
CLEARSIGHT_FORM_AI_TIMEOUT=20s
CLEARSIGHT_FORM_AI_MAX_OUTPUT_BYTES=1048576
# development + demo mode uses the built-in role login; non-demo development uses the configured identity below.
# signed keeps the trusted gateway contract; oidc enables native enterprise sign-in.
CLEARSIGHT_IDENTITY_MODE=development
CLEARSIGHT_IDENTITY_HMAC_SECRET=
CLEARSIGHT_IDENTITY_MAX_SKEW=2m
# OIDC mode uses Authorization Code + PKCE and server-side SCS sessions.
# CLEARSIGHT_ALLOWED_ORIGIN is also the trusted application origin used after the callback.
CLEARSIGHT_OIDC_ISSUER=
CLEARSIGHT_OIDC_CLIENT_ID=
CLEARSIGHT_OIDC_CLIENT_SECRET=
CLEARSIGHT_OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
CLEARSIGHT_OIDC_SESSION_LIFETIME=8h
CLEARSIGHT_OIDC_SESSION_IDLE_TIMEOUT=30m
# Production OIDC requires true and HTTPS issuer/application/callback URLs.
CLEARSIGHT_OIDC_SECURE_COOKIES=false
# off, audit or enforce. Production requires enforce.
CLEARSIGHT_COMMAND_AUTHORIZATION=audit
CLEARSIGHT_DEMO_TENANT_ID=bank-demo
CLEARSIGHT_DEMO_PRINCIPAL_ID=role-cro
CLEARSIGHT_DEMO_LEGAL_ENTITY_ID=bank-ng
# Used by non-demo development identity and explicit demo-header compatibility, not by the built-in role catalogue.
CLEARSIGHT_DEMO_ROLE_CODES=CRO,EXECUTIVE
DATABASE_URL=postgres://clearsight:clearsight@localhost:5432/clearsight?sslmode=disable
VITE_API_BASE_URL=http://localhost:8080
# Optional browser-only fallback when the API is unavailable; server demo mode remains authoritative.
VITE_ENABLE_SAMPLE_DATA=false
# Governed AI gateway transport and enforcement.
# Set exactly one config source. Production uses governance_mode=DATABASE and
# the same DATABASE_URL. STATIC transport preserves file-owned provider/model
# routing; DATABASE makes the approved tenant/environment revision authoritative.
CLEARSIGHT_AI_GATEWAY_CONFIG_FILE=
CLEARSIGHT_AI_GATEWAY_CONFIG_JSON=
CLEARSIGHT_AI_GATEWAY_TRANSPORT_MODE=STATIC
# Optional API-to-gateway operations bridge used only to project desired-vs-applied
# transport status in Configure. The token is server-side only and must match the
# gateway operations/metrics bearer digest; it is never returned to the browser.
# Configure URL and token together. HTTPS is required outside local development.
CLEARSIGHT_AI_GATEWAY_OPERATIONS_URL=
CLEARSIGHT_AI_GATEWAY_OPERATIONS_TOKEN=
CLEARSIGHT_AI_GATEWAY_OPERATIONS_TIMEOUT=2s

# Optional bounded document-to-form authoring adapters. PyMuPDF remains disabled
# unless its licensing is explicitly approved; production endpoints require HTTPS.
CLEARSIGHT_PDF_PARSER_ADAPTER=
CLEARSIGHT_PDF_PARSER_ENDPOINT=
CLEARSIGHT_PYMUPDF_LICENSE_APPROVED=false
CLEARSIGHT_PARSER_ADAPTER_TIMEOUT=30s
CLEARSIGHT_PARSER_ADAPTER_MAX_OUTPUT_BYTES=8388608
# Legacy .xls conversion is worker-only and requires an explicitly provisioned executable.
CLEARSIGHT_LEGACY_OFFICE_EXECUTABLE=
CLEARSIGHT_LEGACY_OFFICE_TIMEOUT=30s
CLEARSIGHT_LEGACY_OFFICE_MAX_OUTPUT_BYTES=67108864

# Optional governed form-authoring workload. Supply every binding together or
# leave all values empty so manual and deterministic authoring remain available.
CLEARSIGHT_FORM_AI_GATEWAY_URL=
CLEARSIGHT_FORM_AI_TENANT_ID=
CLEARSIGHT_FORM_AI_WORKLOAD_ID=
CLEARSIGHT_FORM_AI_CREDENTIAL=
CLEARSIGHT_FORM_AI_MODEL_ALIAS=
CLEARSIGHT_FORM_AI_PROMPT_VERSION=FORM_AUTHORING_V1
CLEARSIGHT_FORM_AI_TIMEOUT=20s
CLEARSIGHT_FORM_AI_MAX_OUTPUT_BYTES=1048576
